# Copia este archivo a .env.local y llena los valores. Nunca subas .env.local.
# Los valores salen de Supabase: Project Settings > API Keys (proyecto mot-dev).

# URL del proyecto, p. ej. https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Llave publicable (sb_publishable_...). Puede llegar al navegador; RLS protege los datos.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Llave secreta (sb_secret_...). Solo servidor: salta RLS.
SUPABASE_SECRET_KEY=

# Referencia del proyecto (el <ref> de la URL). Solo la usa la CLI de Supabase.
SUPABASE_PROJECT_REF=
